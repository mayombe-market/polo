# =============================================================================
# VARIABLES D'ENVIRONNEMENT — BRANCHE preview-marketplace (STAGING UNIQUEMENT)
# =============================================================================
# Ce fichier documente les variables à configurer dans Vercel Preview.
# NE PAS utiliser les valeurs de production ici.
# NE PAS committer de vraies clés dans ce fichier.
#
# Dans Vercel : Settings → Environment Variables → Sélectionner "Preview" only
# =============================================================================

# ─── Supabase STAGING ─────────────────────────────────────────────────────────
# Créer un nouveau projet Supabase dédié au staging (ex: "mayombe-market-staging")
# NE PAS utiliser les clés du projet de production
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET_STAGING.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...ANON_KEY_STAGING
SUPABASE_SERVICE_ROLE_KEY=eyJ...SERVICE_ROLE_KEY_STAGING

# ─── Mode Staging ────────────────────────────────────────────────────────────
# Active le mode staging : désactive l'envoi des emails (log uniquement)
NEXT_PUBLIC_STAGING_MODE=true

# ─── URL de l'application ─────────────────────────────────────────────────────
# URL de la Preview Vercel (format automatique Vercel)
NEXT_PUBLIC_APP_URL=https://polo-git-preview-marketplace-mayombe-market.vercel.app

# ─── Auth Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=https://polo-git-preview-marketplace-mayombe-market.vercel.app/auth/callback

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# En staging : laisser vide OU mettre une clé de test Resend
# Avec NEXT_PUBLIC_STAGING_MODE=true, les emails sont loggués mais non envoyés
# quelle que soit la valeur de RESEND_API_KEY
RESEND_API_KEY=
# Email de redirection pour les tests (optionnel — non utilisé si STAGING_MODE=true)
# RESEND_TEST_EMAIL=test@staging.mayombe-market.com

# ─── Push Notifications ──────────────────────────────────────────────────────
# Laisser vide en staging — le code ignore silencieusement si absent
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── MTN MoMo ─────────────────────────────────────────────────────────────────
# TOUJOURS utiliser sandbox en staging — NE JAMAIS utiliser les clés production
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_COLLECTION_PRIMARY_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=staging-test-secret

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Peut utiliser le même compte Cloudinary (images de test dans un dossier séparé)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── NextAuth / Session ───────────────────────────────────────────────────────
NEXTAUTH_SECRET=staging-secret-random-32-chars-minimum
NEXTAUTH_URL=https://polo-git-preview-marketplace-mayombe-market.vercel.app

# =============================================================================
# VARIABLES NON REQUISES EN STAGING (NE PAS CONFIGURER)
# =============================================================================
# Ces services ne doivent pas être actifs en staging :
#
# STRIPE_SECRET_KEY          — Pas de paiement réel
# STRIPE_WEBHOOK_SECRET      — Pas de webhook Stripe
# SENDGRID_API_KEY           — Non utilisé (Resend)
#
# =============================================================================
# CHECKLIST AVANT DÉPLOIEMENT PREVIEW
# =============================================================================
# [ ] NEXT_PUBLIC_SUPABASE_URL pointe vers la base STAGING (pas production)
# [ ] SUPABASE_SERVICE_ROLE_KEY est la clé STAGING (pas production)
# [ ] NEXT_PUBLIC_STAGING_MODE=true
# [ ] MTN_MOMO_ENVIRONMENT=sandbox
# [ ] RESEND_API_KEY vide ou clé test
# [ ] Migration supabase-staging-ORDERED-MIGRATIONS.sql appliquée sur staging
# [ ] Seed supabase-staging-seed.sql appliqué
# =============================================================================
